{
  "$schema": "https://raw.githubusercontent.com/nicokosi/tauri-v2/main/core/tauri-config-schema/schema.json",
  "productName": "Binaural Beats",
  "version": "0.1.0",
  "identifier": "com.wundark.binaural-beats",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Binaural Beats",
        "width": 820,
        "height": 740,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/binaural-engine"
    ],
    "resources": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Utility",
    "shortDescription": "Binaural beats and pink noise sessions",
    "longDescription": "Plays and exports binaural beat sessions with pink noise: a built-in session library, YAML and SBaGen session files, a timeline of the session, and pause, seek and volume control.",
    "publisher": "Wundark",
    "licenseFile": "../../LICENSE"
  }
}
